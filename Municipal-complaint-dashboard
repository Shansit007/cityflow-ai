def pill(text, sev):
    return f'<span class="pill" style="background:{SEV_BG[sev]};color:{SEV_COLORS[sev]};">{text}</span>'

def flow_diagram(steps, highlight_last=True):
    html = ""
    for i, s in enumerate(steps):
        cls = "hi" if (highlight_last and i == len(steps) - 1) else ""
        html += f'<div class="flow-step {cls}">{s}</div>'
        if i < len(steps) - 1:
            html += '<div class="flow-arrow">↓</div>'
    st.markdown(f'<div style="max-width:440px;">{html}</div>', unsafe_allow_html=True)

def bar_row(name, pct, color):
    st.markdown(f"""
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
      <div class="barrow-name" style="width:150px;flex-shrink:0;">{name}</div>
