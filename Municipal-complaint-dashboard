        <div style="height:100%;width:{pct}%;background:{color};border-radius:4px;"></div>
      </div>
      <div style="width:38px;text-align:right;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:{MUTED};">{pct}%</div>
    </div>
    """, unsafe_allow_html=True)

def make_map(center, zoom, markers=None, highlight_id=None, satellite=False):
    m = folium.Map(location=center, zoom_start=zoom, tiles=None, control_scale=True)
    if satellite:
        folium.TileLayer(
            tiles="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
            attr="Esri, Maxar, Earthstar Geographics", name="Satellite",
        ).add_to(m)
    else:
        folium.TileLayer(tiles="OpenStreetMap", attr="© OpenStreetMap contributors").add_to(m)
    if markers:
        for r in markers:
            is_hi = r["id"] == highlight_id
            folium.CircleMarker(
                location=[r["lat"], r["lng"]],
                radius=11 if is_hi else 8,
                color="#fff", weight=2,
                fill=True, fill_color=SEV_COLORS[r["sev"]], fill_opacity=0.95,
                popup=f"<b>{r['id']}</b><br>{r['loc']}<br>{SEV_LABEL[r['sev']]} · {r['statusLabel']}",
            ).add_to(m)
    return m

def sensor_chart(kind, color):
    fig, ax = plt.subplots(figsize=(4.4, 1.5))
    if kind == "accel":
        y = [0, 0, 0, 0.05, -0.05, -3.6, 2.8, -1.0, 0, 0, 0]
    else:
        y = [0, 0, 0, 0, 0.6, -2.9, 1.4, -0.4, 0, 0, 0]
    x = list(range(len(y)))
    ax.plot(x, y, color=color, linewidth=2)
    ax.axhline(0, color="#D7DEE6", linewidth=0.8)
    ax.annotate("IMPACT", xy=(5, y[5]), xytext=(5.3, max(y) if max(y) > 0 else 1.2),
                fontsize=8, color="#C62F1D", fontfamily="monospace")
    ax.set_xticks([]); ax.set_yticks([])
    for spine in ax.spines.values():
        spine.set_visible(False)
    fig.patch.set_alpha(0)
    ax.set_facecolor("none")
    st.pyplot(fig, use_container_width=True)
    plt.close(fig)

