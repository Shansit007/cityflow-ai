# Postgres with PostGIS. docker compose in infra/ brings one up on this URL.
DATABASE_URL=postgresql://cityflow:cityflow@127.0.0.1:5432/cityflow

# Signing key for the session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Where the Python engine is reachable from the Next apps.
ENGINE_URL=http://127.0.0.1:8000

# Read by services/engine. Same database, ENGINE_ prefix because the service
# loads its settings independently of the web apps.
ENGINE_DATABASE_URL=postgresql://cityflow:cityflow@127.0.0.1:5432/cityflow
ENGINE_LOG_LEVEL=INFO
