# ---------------------------------------------------------------------------
# SUMO working files — generated, and far too large for git.
#
#   city.net.xml       ~71 MB   built by netconvert
#   city.osm.xml       ~50 MB   downloaded from OpenStreetMap
#   *.summary.xml      ~15 MB   one per simulation run
#
# GitHub rejects files over 100 MB and slows badly well before that, and none
# of this is source: every file here is reproducible from the scripts plus an
# OSM extract. Committing them would add hundreds of megabytes to every clone
# for no benefit.
#
# What IS committed: the scripts, this file, and the README — everything
# needed to reproduce a run.
#
# The result itself lives in docs/09-RESULTS.md, which is the thing worth
# keeping in version control.
# ---------------------------------------------------------------------------

# The road network and its source
*.osm
*.osm.xml
*.net.xml

# Demand exported from the Admin Portal
*.trips.xml

# Routing output
*.rou.xml
*.rou.alt.xml

# Zone definitions (regenerated from the network every run)
tazs.add.xml

# Simulation output
*.summary.xml
*.tripinfo.xml

# Scratch
test.xml
__pycache__/
