// =============================================================================
// CityFlow AI — database schema (Prisma + PostgreSQL / Neon)
// =============================================================================
// PHASE 1: User + anonymous CityFlow ID.
// PHASE 2: TravelProfile (the regular routine) + Recommendation (what we
//          suggested, what the person actually chose).
//
// Still to come:
//   PHASE 3 — TravelIntention, DemandSlot (aggregated city demand)
//   PHASE 4 — AdminReport / SimulationRun
//   PHASE 5 — RoadImpactReport
//
// After changing anything here, run:   npm run db:push
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// USER
// -----------------------------------------------------------------------------

/// A registered commuter of the CityFlow AI user portal.
///
/// PRIVACY NOTE
/// The email address exists only for authentication, account recovery and
/// important service communication. Everywhere else in the system — analytics,
/// aggregated demand, the Admin Portal — a user is referenced by `cityflowId`,
/// never by email or name.
model User {
  /// Internal primary key. Never shown in the UI.
  id String @id @default(cuid())

  /// Login identity. Stored lower-cased so "A@b.com" and "a@b.com" are one account.
  email String @unique

  /// bcrypt hash of the password. The plain password is never stored anywhere.
  passwordHash String

  /// Optional display name / nickname used only to greet the user.
  displayName String?

  /// Anonymous public identifier, e.g. "CF-8X42K91".
  cityflowId String @unique

  /// Which city the user is currently viewing (e.g. "delhi").
  cityCode String?

  /// Set to true once the travel-routine onboarding is finished.
  onboardingCompleted Boolean @default(false)

  /// Role separation. Commuters are "USER"; the Admin Portal (Phase 4) uses "ADMIN".
  role UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelProfile    TravelProfile?
  recommendations  Recommendation[]
  travelIntentions TravelIntention[]
  chatMessages     ChatMessage[]

  @@index([cityCode])
  @@map("users")
}

/// Role separation between the User Portal and the Admin Portal.
/// The Municipal Dashboard is a separate existing system and is NOT a role here.
enum UserRole {
  USER
  ADMIN
}

// -----------------------------------------------------------------------------
// TRAVEL PROFILE — the regular routine, captured during onboarding
// -----------------------------------------------------------------------------

/// One per user. Everything the recommendation engine needs to know about how
/// this person normally travels, and how much of that is negotiable.
model TravelProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Step 1: the journey ---------------------------------------------------

  /// Free-text area name, e.g. "Salt Lake Sector 5". Deliberately NOT a precise
  /// address — an area is enough to place a trip in a demand zone.
  homeArea String

  /// Where they travel to on a normal day.
  destinationArea String
  destinationType DestinationType @default(WORK)

  /// How they usually get there.
  primaryMode TransportMode

  // --- Step 2: the schedule --------------------------------------------------

  /// 24-hour "HH:MM". Stored as text because it is a wall-clock time of day,
  /// not a moment in time — it means "09:00 every working day", not one date.
  usualDeparture String

  /// The time they need to have arrived by, "HH:MM".
  requiredArrival String

  /// How long the trip normally takes them, in minutes, in light traffic.
  /// Supplied by the user — CityFlow AI does not yet do live route timing, and
  /// inventing a number here would make every estimate downstream dishonest.
  typicalJourneyMinutes Int @default(20)

  /// Which days this routine applies to, e.g. ["MON","TUE","WED","THU","FRI"].
  travelDays String[]

  /// Whether the departure time can move at all. If false, CityFlow AI will
  /// still show demand, but will not suggest a different time.
  isFlexible Boolean @default(true)

  /// How far the departure may move, in minutes (0, 15, 30 or 60).
  flexibilityMinutes Int @default(15)

  // --- Step 3: preferences ---------------------------------------------------

  /// Modes the person is open to besides their primary one.
  preferredModes TransportMode[]

  /// The largest extra delay they would accept versus their normal arrival.
  maxAcceptableDelayMinutes Int @default(15)

  willingToLeaveEarlier Boolean @default(true)
  willingToLeaveLater   Boolean @default(false)

  carpoolInterest         Boolean @default(false)
  publicTransportInterest Boolean @default(false)

  // --- Step 4: privacy choices ----------------------------------------------

  /// Whether this person's (anonymised) routine may be counted in the
  /// city-level demand totals used for planning.
  shareAggregatedDemand Boolean @default(true)

  /// Whether CityFlow AI may notify them when a recommendation changes.
  allowNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("travel_profiles")
}

enum DestinationType {
  WORK
  COLLEGE
  SCHOOL
  OTHER
}

enum TransportMode {
  CAR
  BIKE
  BUS
  METRO
  WALK
  CYCLE
  OTHER
}

// -----------------------------------------------------------------------------
// RECOMMENDATION — what we suggested, and what the person actually did
// -----------------------------------------------------------------------------

/// One recommendation per user per day.
///
/// Storing the demand figures alongside the recommendation matters: it is what
/// makes "why am I seeing this?" answerable later, and it is what lets us show
/// an honest history instead of re-deriving numbers that have since changed.
model Recommendation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The travel date this recommendation is for (date only, no time).
  travelDate DateTime @db.Date

  /// City the demand figures were computed for.
  cityCode String

  /// The person's normal departure at the time of the recommendation.
  usualDeparture String

  /// What CityFlow AI suggested, "HH:MM".
  recommendedDeparture String

  /// Predicted demand index (0-100) at each of those two times.
  demandAtUsual       Int
  demandAtRecommended Int

  /// Plain-language explanation shown to the user.
  reason String

  /// Whether the person took the suggestion.
  status RecommendationStatus @default(PENDING)

  /// The departure time the person actually decided on, once they choose.
  chosenDeparture String?

  /// PHASE 3 — set when the city-wide optimiser changed this recommendation
  /// after other people's confirmed plans shifted demand.
  updatedByOptimiser Boolean @default(false)

  /// Plain-language explanation of WHY it was updated, shown as a notification.
  /// Null when the recommendation has never been re-optimised.
  updateReason String?

  /// False until the person has seen the update notice.
  updateAcknowledged Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One recommendation per user per travel date.
  @@unique([userId, travelDate])
  @@index([cityCode, travelDate])
  @@map("recommendations")
}

enum RecommendationStatus {
  /// Shown, not yet acted on.
  PENDING
  /// The person chose the recommended time.
  ACCEPTED
  /// The person chose to keep their usual time.
  KEPT_USUAL
  /// The person set some other time of their own.
  CUSTOM
}

// =============================================================================
// PHASE 3 — travel intentions, aggregated demand, network events
// =============================================================================

/// A confirmed change to a person's travel plan for one specific date.
///
/// THIS IS THE STRUCTURED TRUTH, NOT THE CHAT TEXT.
/// The assistant's job is to turn a sentence into one of these rows. The raw
/// conversation is never stored and is never the source of truth — if the
/// parser understood something wrongly, the person corrects the STRUCTURED
/// value on a confirmation card before anything is written.
model TravelIntention {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The date this plan applies to (date only, no time).
  travelDate DateTime @db.Date

  cityCode String

  /// Normalised area names. See lib/demand/zones.ts for how these are derived.
  originZone      String
  destinationZone String

  /// What the person's saved routine says, "HH:MM".
  plannedDeparture String

  /// What they now intend to do, "HH:MM".
  updatedDeparture String

  transportMode TransportMode

  status IntentionStatus @default(CONFIRMED)

  /// Where the intention came from, so chat-driven changes can be told apart
  /// from ones made directly on the dashboard.
  source IntentionSource @default(CHAT)

  /// True once this row has been counted into the aggregated demand table.
  /// Prevents a retry or a double submit from inflating city demand.
  countedInDemand Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live intention per user per date. A new one supersedes the old.
  @@unique([userId, travelDate])
  @@index([cityCode, travelDate, updatedDeparture])
  @@map("travel_intentions")
}

enum IntentionStatus {
  /// Counted in aggregated demand.
  CONFIRMED
  /// The person said they are not travelling.
  CANCELLED
  /// Replaced by a newer intention for the same date.
  SUPERSEDED
}

enum IntentionSource {
  CHAT
  DASHBOARD
}

/// Aggregated demand for one city, one date, one 15-minute slot.
///
/// PRIVACY: this table holds COUNTS ONLY. There is no user id, no CityFlow ID
/// and no route here — it is deliberately impossible to work backwards from a
/// row to a person. This is the table the Admin Portal reads in Phase 4.
model DemandSlotAggregate {
  id String @id @default(cuid())

  cityCode   String
  travelDate DateTime @db.Date

  /// Slot start, in minutes since midnight (0, 15, 30 …).
  slotMinutes Int

  /// How many confirmed trips are expected to start in this slot.
  confirmedTrips Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([cityCode, travelDate, slotMinutes])
  @@index([cityCode, travelDate])
  @@map("demand_slot_aggregates")
}

/// Something happening on the network that changes demand or capacity.
///
/// NOTHING IS CONNECTED TO A LIVE FEED. Rows are entered by hand (the Admin
/// Portal gains a form in Phase 4). The model exists so that when a real
/// accident, closure or weather feed is available, it writes rows here and the
/// prediction, recommendation and notification path already works end to end.
model NetworkEvent {
  id String @id @default(cuid())

  cityCode String
  kind     NetworkEventKind

  /// Free-text area this affects, normalised the same way as travel zones.
  /// Null means the whole city.
  affectedZone String?

  /// When the event applies, as minutes since midnight on `eventDate`.
  eventDate    DateTime @db.Date
  startMinutes Int
  endMinutes   Int

  /// How much this pushes the demand index up, in index points (0-60).
  /// A closure reduces capacity, which shows up here as higher effective demand.
  demandImpact Int @default(15)

  description String

  /// Where the row came from. "manual" today.
  source String @default("manual")

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([cityCode, eventDate, active])
  @@map("network_events")
}

enum NetworkEventKind {
  ACCIDENT
  ROAD_CLOSURE
  WEATHER
  PUBLIC_EVENT
  OTHER
}

// -----------------------------------------------------------------------------
// ASSISTANT CONVERSATION
// -----------------------------------------------------------------------------

/// One message in a person's conversation with Saarthi.
///
/// WHY THIS IS STORED AT ALL
/// The conversation used to live only in the browser tab, which was the most
/// private option but meant history vanished on every close. Since the point of
/// the assistant is an ongoing relationship with a commuter's routine, the
/// history is now kept per user so it is there on their next visit and on their
/// other devices.
///
/// WHAT THIS DOES NOT CHANGE
/// The transcript is still NEVER the source of truth. Every travel decision the
/// system acts on lives in `travel_intentions` as structured data that the
/// person explicitly confirmed. Nothing reads these rows to make a decision —
/// they exist only so the person can see what was said.
///
/// The person can delete the whole conversation at any time from the assistant
/// page, and deleting their account removes it with them.
model ChatMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ChatRole

  /// What was said. Plain text.
  text String

  /// A snapshot of the proposal card shown with an assistant message, so the
  /// history renders exactly as it did at the time — including the numbers,
  /// which would otherwise have moved on.
  proposal Json?

  /// Whether this message was waiting on a Confirm press.
  requiresConfirmation Boolean @default(false)

  /// False only while a proposal is still awaiting a decision.
  resolved Boolean @default(true)

  /// What happened in the end: "Saved — you are planned to leave at…" or
  /// "No change saved."
  outcome String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
}
